# বাধ্যতামূলক — না থাকলে অ্যাপ ক্র্যাশ করবে
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-afe0c38f95494e2283eb8310823a49b6

# # ঐচ্ছিক — না থাকলে ফিচার ডিগ্রেড হবে
# LANGCHAIN_API_KEY=
# MCP_SERVER_URL=http://localhost:8080/mcp
# CHROMA_HOST=localhost
# CHROMA_PORT=8000





# ══════════════════════════════════════════════════════════════
# Nexus-AI Platform — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to git.
# ══════════════════════════════════════════════════════════════

# ── App Meta ──
APP_NAME="Nexus-AI Platform"
APP_VERSION="0.1.0"
APP_ENV=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Server ──
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── LLM Provider ──
# Options: ollama (local, free) | deepseek | openai | groq
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# Only the API key matching LLM_PROVIDER is required. Leave others blank.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Vector Store ──
CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION=betsson_policy
CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── MCP (Phase 2 te enable korben) ──
MCP_ENABLED=false
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m,mcp_server.mock_audit_server
MCP_HEALTH_TIMEOUT=5.0
MCP_CALL_TIMEOUT=10.0

# ── Observability ──
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexus-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Safety / Harness ──
CITATION_MIN_FAITHFULNESS=0.85
MAX_USER_MESSAGE_CHARS=4000
RATE_LIMIT_PER_MINUTE=30



python -c "from app.config import get_settings; s = get_settings(); print(f'Provider: {s.llm_provider}'); print(f'Model: {s.llm_model}'); print(f'Env: {s.app_env}'); print(f'Debug: {s.debug}')"